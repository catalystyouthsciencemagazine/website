---
interface Props {
	href?: string;
	style: "primary" | "inverted-primary" | "secondary";
}

const { href, style } = Astro.props;
---

<a
	{href}
	class:list={[
		"shadow-indigo/20 shadow-sm px-5 py-3 rounded-full transition-all hover:scale-[101%] font-medium ",
		style == "primary"
			? "bg-indigo hover:bg-indigo-dark text-indigo-fg"
			: style == "inverted-primary"
				? "bg-indigo-fg text-indigo-darkest"
				: "",
	]}
>
	<slot />
</a>
