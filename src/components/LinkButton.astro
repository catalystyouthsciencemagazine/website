---
interface Props {
	href?: string;
	style: "primary" | "inverted-primary" | "secondary";
}

const { href, style } = Astro.props;
---

<a
	{href}
	class:list={[
		"shadow-accent-bg/20 shadow-sm px-5 py-3 rounded-full transition-all hover:scale-[101%] font-medium ",
		style == "primary"
			? "bg-accent-bg hover:bg-accent-bg-hover text-accent-fg"
			: style == "inverted-primary"
				? "bg-accent-fg text-accent-bg "
				: "",
	]}
>
	<slot />
</a>
