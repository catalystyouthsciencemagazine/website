---
import Layout from "@/components/Layout.astro";
---

<Layout pageTitle="Articles | Catalyst">
	<section class="max-w-6xl mx-auto px-4 py-12">
		<header class="mb-12 text-center sm:text-left">
			<h1 class="text-4xl sm:text-6xl font-serif font-bold text-gray-900 mb-4 tracking-tight">Articles</h1>
			<p class="text-base sm:text-lg text-gray-600 max-w-2xl">
				Explore peer-reviewed research, science journalism, and explainers written by students around the world.
			</p>
		</header>

		<div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<p class="text-gray-500 col-span-full text-center py-16">Loading articles...</p>
		</div>
	</section>
</Layout>

<script>
	import { collection, getDocs, query, where, orderBy } from "firebase/firestore";
	import { db } from "../lib/firebase";

	const grid = document.getElementById("articles-grid")!;

	function esc(str: string): string {
    if (!str) return "";
    return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

	async function loadArticles() {
		try {
			const snap = await getDocs(
  query(collection(db, "submissions"), where("published", "==", true), orderBy("publishedAt", "desc")),
);
const published = snap.docs;

			if (!published.length) {
				grid.innerHTML = `<div class="text-center py-16 bg-gray-50 rounded-2xl border border-dashed border-gray-300 col-span-full">
					<p class="text-gray-500 font-medium">No published articles yet. Check back soon!</p>
				</div>`;
				return;
			}

			grid.innerHTML = "";
			for (const d of published) {
				const data = d.data();
				 const date = data.publishedAt?.toDate ? data.publishedAt.toDate().toLocaleDateString() : "";
				 const  text = data.articleText || "";
				const  excerpt = text.length > 180 ? text.slice(0, 180) + "…" : text;
				 const href = `${import.meta.env.BASE_URL}article?id=${d.id}`;

				const card = document.createElement("article");
				card.className = "bg-white rounded-2xl p-6 sm:p-8 border border-gray-200 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow";
				card.innerHTML = `
					<div>
						<h2 class="text-2xl font-bold text-gray-900 mb-3 hover:text-indigo-600 transition-colors"><a href="${href}">${esc(data.articleTitle || "Untitled")}</a></h2>
						<p class="text-gray-600 text-sm sm:text-base leading-relaxed mb-6">${esc(excerpt)}</p>
					</div>
					<div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs sm:text-sm text-gray-500">
						<span>By <strong class="text-gray-700">${esc(data.fullName || "Unknown")}</strong>${date ? ` &middot; ${date}` : ""}</span>
						<a href="${href}" class="text-indigo-600 font-semibold hover:underline flex items-center gap-1">Read <span aria-hidden="true">&rarr;</span></a>
					</div>
				`;
				grid.appendChild(card);
			}
		} catch (err) {
			console.error(err);
			grid.innerHTML = `<p class="text-gray-500 col-span-full text-center py-16">Failed to load articles.</p>`;
		}
	}

	loadArticles();
</script>
